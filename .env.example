# Supabase Configuration
# Get these values from https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Canonical site URL (optional; used for Open Graph / metadataBase). No trailing slash.
# Use one primary apex in Vercel; multi-brand hosts (ministrysignup.com, etc.) must still be listed
# in Supabase Auth → Redirect URLs — see SUPABASE_SETUP.md — or OAuth returns to Site URL only.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Multi-brand: on localhost or *.vercel.app only, force which pack loads
# (wardsignup | ministrysignup | orgsignup). Production hostnames still win.
# NEXT_PUBLIC_ACTIVE_BRAND=ministrysignup

# Auth: sessions use cookie storage (@supabase/ssr) so middleware can refresh tokens and guard routes.
# After this change, anyone who only had an old localStorage-only session may need to sign in once.

# Local Development Only (when using local Supabase)
# Uncomment these if running `supabase start` locally
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Google OAuth (local Supabase dev only — set in Supabase Dashboard for production)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Optional: Custom SMTP for production email sending
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Email (Resend)
# RESEND_API_KEY=re_...
# Optional: separate Resend API key for Ministry (ministrysignup.com domain on another Resend project)
# RESEND_API_KEY_MINISTRY=re_...
# Optional: override From for magic-link sign-in emails (defaults per brand pack; does not use ORGANIZER_EMAIL_FROM)
# MAGIC_LINK_EMAIL_FROM=
# Participant signup confirmation + ~24h reminders (defaults per brand noreply like magic links; avoid ORGANIZER_EMAIL_FROM)
# PARTICIPANT_EMAIL_FROM=
# Fallback IANA zone when campaign.event_timezone is null (emails + reminder scheduling)
# DEFAULT_EVENT_TIMEZONE=America/Phoenix
# Founder notification on first creator sign-in
# CREATOR_NOTIFY_TO=jon@jrbond.com
# CREATOR_NOTIFY_FROM=Ward Signup <noreply@wardsignup.com>
# Optional: override welcome “from” (defaults per brand pack).
# WELCOME_EMAIL_FROM=Jonathan <jonathan@wardsignup.com>
# Optional: invite emails (falls back to ORGANIZER_EMAIL_FROM, then brand pack).
# INVITES_EMAIL_FROM=Ward Signup <noreply@wardsignup.com>
# Welcome email Reply-To (defaults to jonathan@wardsignup.com). Set if you use a different inbox.
# WELCOME_REPLY_TO=jonathan@wardsignup.com

# Optional: comma-separated emails allowed for POST /api/admin-utils/delete-test-users (test account cleanup)
# DELETABLE_TEST_USER_EMAILS=bondesign+jasper@gmail.com,jon+test@jrbond.com

# Domain automation (scripts/configure-domains.mjs — see DOMAIN_SETUP.md “CLI automation”)
# VERCEL_TOKEN=...                    # vercel.com/account/tokens
# VERCEL_PROJECT_NAME=wardsignup-mvp  # or rely on .vercel/project.json after `vercel link`
# VERCEL_SCOPE=your-team-slug         # optional; Vercel team for --scope
# VERCEL_DOMAINS=ministrysignup.com,www.ministrysignup.com
# SUPABASE_ACCESS_TOKEN=...           # dashboard → Account → Access Tokens (auth write)
# SUPABASE_PROJECT_REF=abcd1234       # optional if NEXT_PUBLIC_SUPABASE_URL is set
# SUPABASE_REDIRECT_URLS=https://ministrysignup.com/auth/callback,https://www.ministrysignup.com/auth/callback
# SUPABASE_SITE_URL=                  # optional; omit in multi-brand to avoid changing primary Site URL

# Creator feedback ask (daily, piggybacked on organizer-digest cron)
# FEEDBACK_ASK_DELAY_DAYS=4
# Pause ask for specific brands (comma-separated). Org Signup is paused by
# default in code until FEEDBACK_ASK_ENABLE_ORGSIGNUP=1 — do not enable until
# queue size is reviewed (no catch-up blast).
# FEEDBACK_ASK_PAUSED_BRANDS=
# FEEDBACK_ASK_ENABLE_ORGSIGNUP=1
# FEEDBACK_DIGEST_FORCE=1

# Global notification email ceiling (fail-closed). Default 100/brand/hour.
# EMAIL_HOURLY_CEILING=100
# EMAIL_UNSUB_SECRET=  # optional; falls back to CRON_SECRET for unsubscribe HMAC

# Resend bounce/complaint webhooks → email_suppressions (Svix-signed).
# Point each Resend project webhook at https://<host>/api/webhooks/resend
# Events: email.bounced, email.complained
# RESEND_WEBHOOK_SECRET=whsec_...
# RESEND_WEBHOOK_SECRET_MINISTRY=whsec_...
# RESEND_WEBHOOK_SECRET_ORG=whsec_...

# Per-deployment brand id (fallback). Known Host headers override this in crons.
# NEXT_PUBLIC_BRAND_ID=wardsignup
